rules_version = '2';

// Reglas de seguridad de Firestore — Solo Para Eva
//
// Modelo:
//   - El catálogo (productos, categorías, configuración) es PÚBLICO en lectura:
//     lo consume el sitio sin sesión. La escritura exige el claim admin (panel /admin).
//   - Los PEDIDOS son inaccesibles desde el navegador, en lectura y escritura.
//     Los escribe únicamente el webhook de Stripe mediante el Admin SDK, que
//     ignora estas reglas por diseño. El panel los lee vía route handler.
//     Contienen nombre, teléfono y dirección de clientes: dato personal.

service cloud.firestore {
  match /databases/{database}/documents {

    // El rol viaja como custom claim en el token; se asigna con
    // `npm run admin -- grant correo`. Una sesión de Google normal (clienta)
    // NO es admin.
    function esAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Catálogo público
    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    // configuracion/colores y configuracion/informacionNegocio
    match /configuracion/{documentoId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    // Pedidos: cero acceso desde el cliente.
    // El Admin SDK (webhook de Stripe) no pasa por aquí.
    match /pedidos/{pedidoId} {
      allow read, write: if false;
    }

    // Todo lo no declarado queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
