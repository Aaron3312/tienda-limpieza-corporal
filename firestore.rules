rules_version = '2';

// Reglas de seguridad de Firestore — Solo Para Eva
//
// Modelo:
//   - El catálogo (productos, categorías, configuración) es PÚBLICO en lectura:
//     lo consume el sitio sin sesión. La escritura exige el claim admin (panel /admin).
//   - Los PEDIDOS los escribe únicamente el webhook de Stripe mediante el Admin
//     SDK, que ignora estas reglas por diseño. Cada clienta lee sólo los suyos;
//     el panel los lee vía route handler. Contienen nombre, teléfono y
//     dirección de clientes: dato personal.

service cloud.firestore {
  match /databases/{database}/documents {

    // El rol viaja como custom claim en el token; se asigna con
    // `npm run admin -- grant correo`. Una sesión de Google normal (clienta)
    // NO es admin.
    function esAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Catálogo público
    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    // configuracion/colores y configuracion/informacionNegocio
    match /configuracion/{documentoId} {
      allow read: if true;
      allow create, update, delete: if esAdmin();
    }

    // Pedidos: los escribe sólo el Admin SDK (webhook de Stripe), que no pasa
    // por aquí. Una clienta con sesión puede leer únicamente los suyos
    // (consulta `where('uid', '==', uid)` desde /cuenta). Las administradoras
    // los leen por route handler, no directo.
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Referencias de checkout: sólo servidor.
    match /checkout_sesiones/{checkoutId} {
      allow read, write: if false;
    }

    // Todo lo no declarado queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
